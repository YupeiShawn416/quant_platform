# Production environment template.
# Copy to .env on the server and fill real secrets there.
# Do not commit real .env files.

RQDATA_LICENSE=

DATA_ROOT=/opt/quant_platform/data/research_data/rqdata
RQALPHA_BUNDLE_PATH=/opt/quant_platform/data/rqalpha_bundle

# Must be changed in production.
API_TOKEN=replace_with_strong_random_token

# API runtime
HOST=127.0.0.1
PORT=8000
WORKERS=2

BACKTEST_EXECUTION_MODE=docker
BACKTEST_RESULT_TTL_HOURS=24
BACKTEST_CURRENT_DIR=/opt/quant_platform/runs/backtests/current
BACKTEST_JOBS_DIR=/opt/quant_platform/runs/backtests/jobs
BACKTEST_IMAGE=quant-platform-backtest:latest
BACKTEST_CPU_LIMIT=1.0
BACKTEST_MEMORY_LIMIT=2g
BACKTEST_TIMEOUT_SECONDS=600
